# Vercel website environment. The key must match the speech service. Never NEXT_PUBLIC_*.
VOICE_BACKEND_URL=https://voice.your-domain.in
VOICE_API_KEY=replace-with-a-long-random-secret
# Local development only:
LOCAL_ARCHIVE_URL=http://127.0.0.1:5001

# Optional multilingual answer service. Server only; never NEXT_PUBLIC_*.
GROQ_API_KEY=replace-with-your-private-api-key
SMRITI_ANSWER_MODEL=openai/gpt-oss-120b
