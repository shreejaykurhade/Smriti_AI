VOICE_API_KEY=replace-with-the-same-long-random-secret
PUBLIC_VOICE_URL=https://voice.your-domain.in
VOICE_ALLOWED_ORIGINS=https://your-domain.in,https://www.your-domain.in,http://localhost:3000
SMRITI_MODEL_DIR=/models
SMRITI_AUDIO_CACHE=/audio-cache
SMRITI_DEVICE=cpu
# Set cuda on an NVIDIA GPU host. Start with one worker to share model memory.
# HF_TOKEN= for gated downloads only; keep it on the model host, never in Vercel's browser bundle.
# Optional prototype providers (internet narration; noncommercial research translation):
SMRITI_TTS_PROVIDER=hybrid
SMRITI_TRANSLATION_PROVIDER=nllb

# Optional public AI4Bharat demo fallback. Shared free quota; not a production SLA.
SMRITI_REMOTE_PARLER=0
